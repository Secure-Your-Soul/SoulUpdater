{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
     "rootDir": ".",
     "outDir": "./Output",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "nodenext",
    "target": "esnext",
    "moduleResolution": "nodenext",
    // For nodejs:
    "lib": ["ESNext"],
     "types": ["node"],
    // and npm install -D @types/node

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
     "noImplicitReturns": true, // Pilnuje, by każda ścieżka w `if/else` coś zwracała
     "noImplicitOverride": true,
     "noUnusedLocals": true, // Błąd, jeśli zdefiniujesz zmienną i jej nie użyjesz
     "noUnusedParameters": true, // Błąd, jeśli funkcja przyjmuje argument, którego nie dotyka
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,

    // Moje Opcje
    "importHelpers": true,
    "removeComments": true,
    "baseUrl": ".",
  }
}
